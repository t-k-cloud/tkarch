{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "plugin": [
    "opencode-scheduler@latest"
  ],
  "keybinds": {
    "app_exit": "ctrl+d",
    "input_submit": "alt+return",
    "input_newline": "enter,ctrl+j",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
    "messages_line_up": "ctrl+y",
    "messages_line_down": "ctrl+e",
    "terminal_suspend": "none"
  },
  "provider": {
    "LocalSGLangProvider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local",
      "options": {
        "baseURL": "http://yetiarch:30000/v1"
      },
      "models": {
        "LocalQwen": {
          "name": "Qwen3.8-FP8",
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "CPAProvider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CPA pool",
      "options": {
        "baseURL": "https://model-pool.highclaws.com/v1",
        "headers": {
          "x-opencode-session": "tk-local"
