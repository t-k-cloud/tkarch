{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "plugin": ["opencode-scheduler@latest"],
  "keybinds": {
    "app_exit": "ctrl+d",
    "input_submit": "alt+return",
    "input_newline": "enter,ctrl+j",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
    "messages_line_up": "ctrl+y",
    "messages_line_down": "ctrl+e",
    "terminal_suspend": "none"
  },
  "provider": {
    "LocalSGLangProvider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local",
      "options": {
        "baseURL": "http://yetiarch:30000/v1"
      },
      "models": {
        "LocalQwen": {
          "name": "Qwen3.8-FP8",
	  "limit": {
            "context": 262144,
            "output": 16384
          },
          "modalities": {
            "input": [ "text", "image" ],
            "output": [ "text" ]
          }
        }
      }
    },
    "MiMoProvider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mimo Token Plan",
      "options": {
        "baseURL": "https://token-plan-sgp.xiaomimimo.com/v1"
      },
      "models": {
        "mimo-v2.5": {
          "name": "mimo-v2.5 (token plan)",
          "modalities": {
            "input": [ "text", "image" ],
            "output": [ "text" ]
          }
        },
        "mimo-v2.5-pro": {
          "name": "mimo-v2.5-pro (token plan)",
          "modalities": {
            "input": [ "text", "image" ],
            "output": [ "text" ]
          }
        }
      }
    },
    "CPAProvider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CPA pool",
      "options": {
        "baseURL": "https://model-pool.highclaws.com/v1"
      },
      "models": {
        "claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (CPA)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gemini-3.6-flash-high": {
          "name": "Gemini 3.6 Flash High (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gemini-pro-agent": {
          "name": "Gemini Pro Agent (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3.8-flash": {
          "name": "Qwen 3.8 Flash (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3.8-max": {
          "name": "Qwen 3.8 Max (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "Qwen/Qwen3.8-27B-FP8": {
          "name": "Local Model (CPA)",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingConfig": { "thinkingBudget": 8192 } },
            "max": { "thinkingConfig": { "thinkingBudget": 32768 } }
          }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        }
      }
    }
  }
}
